# ---- AgentAgency configuration (copy to .env) ----
# Most settings (Telegram, GitHub, executors, worldview, agents) are configured in the web
# setup wizard and stored encrypted in PostgreSQL — no need to edit server files repeatedly.

# PostgreSQL (docker compose builds DATABASE_URL from this password)
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Running without docker compose? Point at any PostgreSQL 14+:
# DATABASE_URL=postgres://user:pass@localhost:5432/agentagency
# Without DATABASE_URL an embedded PostgreSQL (PGlite) under AA_DATA_DIR is used (dev/small installs).

AA_DATA_DIR=./data
AA_WEB_PORT=8080
AA_WEB_BIND=127.0.0.1
# Optional fixed one-time setup token (otherwise printed to the log on first start)
# AA_SETUP_TOKEN=

# Vault master key (base64 32 bytes). If unset, data/master.key is generated.
# Keep a copy OUTSIDE backups — restoring encrypted secrets needs it.
# AA_MASTER_KEY=

# Backup encryption passphrase (required for remote backups; kept separate from the master key)
# AA_BACKUP_PASSPHRASE=

# Optional overrides of wizard-managed values (env wins over stored settings)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_USER_IDS=123456789
# TELEGRAM_LOUNGE_CHAT_ID=-1001234567890
# GITHUB_TOKEN=
# GITHUB_OWNER=

# Executors: official subscription CLIs (paid API keys are stripped from their environment)
CLAUDE_CLI_PATH=claude
CODEX_CLI_PATH=codex
# Optional executors (enable with feature flags executors.gemini / executors.cursor)
GEMINI_CLI_PATH=gemini
CURSOR_CLI_PATH=cursor-agent
# Cursor Agent CLI is not in the image by default. `aa cursor` sets this and rebuilds.
# INSTALL_CURSOR_CLI=true

# Workspaces: local | docker (see docker-compose.workspaces.yml)
AA_WORKSPACE_MODE=local
AA_WORKSPACE_IMAGE=agent-agency/workspace:latest
AA_WORKSPACE_NETWORK=bridge
AA_WORKSPACE_CPUS=2
AA_WORKSPACE_MEMORY=4g
# Upper bound; actual concurrency is reduced automatically from detected CPU/RAM/disk
AA_MAX_CONCURRENT_PROJECTS=2
# Concurrent runs per AI executor (subscription CLIs are rate limited per account)
AA_MAX_RUNS_PER_EXECUTOR=2
# How long a stop waits for running work before cancelling and re-queuing it
AA_SHUTDOWN_GRACE_MS=45000

LOG_LEVEL=info
